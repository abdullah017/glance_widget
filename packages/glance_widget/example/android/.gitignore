# The Gradle wrapper is deliberately checked in, against the Flutter template's
# default. It pins the Gradle version this plugin is built and tested against,
# and CI needs it to run the Android module's unit tests without first paying
# for a full APK build to have Flutter inject it.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
