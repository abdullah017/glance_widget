# `.pubignore` REPLACES `.gitignore` for publishing — the two do not merge.
# Anything that must stay out of the published archive has to be listed here.
# glance_widget 1.0.1 shipped a 15 MB archive because this file only had `docs/`.

build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
docs/

# The example's native host projects are large and useless to consumers;
# pub.dev only renders example/lib.
example/android/
example/ios/
example/macos/
example/linux/
example/windows/
example/web/
example/build/
example/.dart_tool/

*.log
.DS_Store
.idea/
.vscode/
*.iml
coverage/
